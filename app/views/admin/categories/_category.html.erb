<div id="<%= dom_id category %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Name:</strong>
    <%= category.name %>
  </p>
  <p class="my-5">
    <strong class="block font-medium mb-1">Slug:</strong>
    <%= category.slug %>
  </p>
  <p class="my-5">
    <strong class="block font-medium mb-1">Parent:</strong>
    <%= category.parent_id %>
  </p>
</div>

<% if @parent_category %>
  <h2 class="text-xl font-semibold"> Subcategories of <%= @parent_category.name %></h2>
  <%= link_to 'Back to Categories', admin_categories_path, class: "text-blue-500 underline" %>
<% else %>
  <h2 class="text-xl font-semibold">Categories</h2>
  <%= link_to "New Category", new_admin_category_path, class: "mt-2 inline-block bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" %>
<% end %>
<div class="mt-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% @admin_categories.each do |category| %>
    <div class="border p-4 rounded-lg shadow-sm hover:shadow-md transition duration-200">
      <h3 class="text-lg font-bold">
        <%= link_to category.name, admin_category_path(category.id), class: "text-blue-600" %>
      </h3>
      <p class="text-sm text-gray-500">Subcategories: <%= category.subcategories.count %></p>
      <%= link_to "New Sub-category", new_admin_category_subcategory_path(category.id), class: "mt-2 inline-block bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" %>
      <% if category.image.attached? %>
        <%= image_tag category.image, alt: category.name, class: "rounded-full border mt-2 w-10 h-10" %>
      <% else %>
        <%= image_tag "https://placehold.co/150", alt: "No Image", class: "rounded-full border mt-2" %>
      <% end %>
    </div>
  <% end %>
</div>

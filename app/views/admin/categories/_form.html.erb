<%= form_with(model: [:admin, @admin_category], url: @admin_category.persisted? ? admin_category_path(@admin_category.id) : admin_categories_path, method: @admin_category.persisted? ? :patch : :post, class: "contents") do |form| %>
  <div class="mb-4">
    <%= form.label :name, "Category Name", class: "block text-lg font-semibold" %>
    <%= form.text_field :name, class: "mt-2 block w-full px-4 py-2 border rounded-lg", required: true %>
  </div>
  <div class="my-5">
    <%= form.label :image, class: "block text-lg font-semibold" %>
    <%= form.file_field :image, rows: 4, class: "block shadow rounded-md border border-gray-200 outline-none px-3 py-2 mt-2 w-full" %>
  </div>
  <div class="mb-4">
    <%= form.label :parent_id, "Parent Category", class: "block text-lg font-semibold" %>
    <%= form.collection_select :parent_id, Category.where(parent_id: nil), :id, :name, include_blank: true, class: "mt-2 block w-full px-4 py-2 border rounded-lg" %>
  </div>
  <div class="inline">
    <%= form.submit @admin_category.persisted? ? "Update Category" : "Create Category", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>

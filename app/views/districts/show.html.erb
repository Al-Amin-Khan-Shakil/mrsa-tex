<div class="container mx-auto px-4 py-6">
  <h1 class="text-3xl font-bold mb-4"><%= @district.name %></h1>
  <div class="mb-6">
    <h2 class="text-2xl font-semibold">Sub-Districts</h2>
    <ul class="list-disc pl-5">
      <% @district.sub_districts.each do |sub_district| %>
        <li><%= sub_district.name %></li>
      <% end %>
    </ul>
  </div>
  <div class="flex space-x-4">
    <%= link_to 'Edit', edit_district_path(@district), class: "bg-yellow-500 text-white px-4 py-2 rounded-lg hover:bg-yellow-600" %>
    <%= link_to 'Back', districts_path, class: "bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600" %>
    <%= button_to 'Delete', district_path(@district), method: :delete, data: { confirm: 'Are you sure?' }, class: "bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600" %>
  </div>
</div>
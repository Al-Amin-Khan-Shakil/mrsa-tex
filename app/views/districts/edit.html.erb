<div>
  <%= form_with model: @district, local: true, class: "space-y-6" do |form| %>
    <div class="field">
      <%= form.label :name, class: "block text-lg font-medium text-gray-700" %>
      <%= form.text_field :name, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>
    <div class="fields space-y-4" id="sub_districts">
      <%=form.fields_for :sub_districts do |sd_form| %>
        <div class="sub-district-fields space-y-4 p-4 border border-gray-300 rounded-lg bg-gray-50" data-sub-district-id="<%= sd_form.index %>">
          <%= sd_form.hidden_field :id %>
          <div class="field">
            <%= sd_form.label :name, "Sub-District", class: "block text-sm font-medium text-gray-700" %>
            <%= sd_form.text_field :name, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" %>
            <%= sd_form.hidden_field :_destroy, class: "destroy-field" %>
          </div>
          <a href="#" class="remove-sub-district inline-block bg-red-500 text-white px-4 py-2 rounded-md hover:bg-red-600">Remove Sub-district</a>
        </div>
      <% end %>
    </div>
    <%= link_to 'Add Sub-district', '#', id: 'add-sub-district', class: 'inline-block bg-indigo-500 text-white px-4 py-2 rounded-md hover:bg-indigo-600' %>
    <%= form.submit 'Update District', class: 'mt-4 inline-block bg-blue-500 text-white px-6 py-3 rounded-md hover:bg-blue-600' %>
  <% end %>
</div>

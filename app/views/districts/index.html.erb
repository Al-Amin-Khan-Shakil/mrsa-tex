<div class="container mx-auto px-4 py-6">
  <h1 class="text-3xl font-bold mb-6">Districts</h1>
  <div class="flex justify-end mb-4">
    <%= link_to 'New District', new_district_path, class: "bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600" %>
  </div>
  <table class="min-w-full bg-white rounded-lg shadow-md">
    <thead>
      <tr>
        <th class="py-2 px-4 border-b">Name</th>
        <th class="py-2 px-4 border-b">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @districts.each do |district| %>
        <tr class="hover:bg-gray-100">
          <td class="py-2 px-4 border-b"><%= district.name %></td>
          <td class="py-2 px-4 border-b flex space-x-2">
            <%= link_to 'Show', district_path(district), class: "text-blue-500 hover:underline" %>
            <%= link_to 'Edit', edit_district_path(district), class: "text-yellow-500 hover:underline" %>
            <%= link_to 'Delete', district_path(district), method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-500 hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>